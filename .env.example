# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Публичный адрес приложения — нужен для ссылок-приглашений и OAuth-редиректов
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Панель администратора (необязательно) ---
# Ключ service_role из того же раздела. Читается только на сервере: даёт панели
# доступ ко всем древам и к управлению пользователями. Без него панель откроется,
# но данных не покажет.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Почты администраторов через запятую — запасной вход, работает даже без таблицы admins.
ADMIN_EMAILS=you@example.com
